# Cloudflare Pages 會讀這個檔（GitHub Pages 會忽略它）。
# 原則：會改版的入口檔每次都向伺服器確認；檔名含雜湊或不會變的大檔可以放心長期快取。

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: microphone=(self), camera=(), geolocation=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self' blob:; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
# CSP 說明：script/connect 允許 Cloudflare 自動插入的流量統計（若在後台關掉 Web Analytics 可一併移除）；
# style 的 'unsafe-inline' 是給 React 的 style 屬性（例如音準指針位置）用，沒有任何內嵌 <script>。

# service worker 與預快取清單一定要拿最新的，否則手機收不到新版
/sw.js
  Cache-Control: no-cache
/precache.json
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/pitch-lab.html
  Cache-Control: no-cache

# 建置輸出的檔名帶內容雜湊，內容不會變
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 吉他取樣（約 2 MB 一個，不會變）
/samples/*
  Cache-Control: public, max-age=2592000
